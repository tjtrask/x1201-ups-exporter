[Unit]
Description=Suptronics X1201 UPS Prometheus Exporter
After=network.target

[Service]
Type=simple
User=x1201-exporter
Group=x1201-exporter
SupplementaryGroups=i2c gpio
ExecStart=/usr/local/bin/x1201_exporter.py
Restart=always
RestartSec=10
Environment=X1201_PORT=9121

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
